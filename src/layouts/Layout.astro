---

<!doctype html>
<html lang="en" class="">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width" />
        <meta name="generator" content={Astro.generator} />
        <script src="https://kit.fontawesome.com/2573478366.js" crossorigin="anonymous"></script>
        <link rel="icon" href="favicon.ico">
        <title>Lily</title>
       
    </head>
<body >
    <div class="bg-dark-amethyst items-center flex flex-col min-h-screen font-family-roboto ">
        <div class=" bg-lime-green flex flex-1 min-w-screen max-h-80 min-h-60 wavy">
            <div class="wavy bg-muted-teal flex flex-1 min-w-screen max-h-35"></div>
            <p class="font-family-roboto h-10 absolute top-5 left-12 text-2xl text-dusk-blue">Lily beach</p>
        </div>
   
        <div class="flex flex-1 items-center justify-center gap-36 relative not-md:flex not-md:flex-col">
            <NavigationAstroComponent></NavigationAstroComponent>
            <img src="/path.png" alt="" class="h-25 w-45 absolute left-53 hidden md:flex">
            <slot>
            </slot>
        </div>


    </div>
